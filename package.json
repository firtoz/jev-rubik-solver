{
  "name": "jev-rubik-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1 --port 3000",
    "build": "bun --bun vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lab": "bun scripts/lab.ts",
    "start": "bun scripts/serve.ts",
    "check": "bun test && bun run typecheck && bun run verify:recordings && bun run build && bun run release:check",
    "verify:recordings": "bun scripts/verify-recordings.ts",
    "release:check": "bun scripts/release-check.ts",
    "release:export": "bun scripts/export-public.ts",
    "build:pages": "node node_modules/vite/bin/vite.js build"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.56",
    "cubing": "0.63.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.170.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "^3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "description": "A recorded study and interactive lab for solving a Rubik\u2019s cube with typed JEV decisions.",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.13"
  }
}
